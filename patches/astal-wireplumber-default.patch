+// The default speaker and microphone follow the default named in the
+// metadata, but only to a node already here: after wireplumber restarts, the
+// new default is named before its node comes (its device later still), and
+// they stayed on the one gone, volume and mute going nowhere. Each new
+// endpoint asks again.
+static void astal_wp_wp_default_may_be_here(AstalWpWp *self) {
+    AstalWpWpPrivate *priv = astal_wp_wp_get_instance_private(self);
+    if (priv->defaults != NULL) g_signal_emit_by_name(priv->defaults, "changed");
+}
