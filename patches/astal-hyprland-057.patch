     }
+
+    // Hyprland 0.57 numbers only regular workspaces: a special one has no
+    // "id", and events name every workspace by its address ("3",
+    // "special:minimized") rather than by its id. A special workspace keeps a
+    // negative id here, the same one for the same name, so nothing keyed by
+    // id has to change; an empty address is no workspace (id 0, as before).
+    internal static int workspace_id(string address) {
+        if (address == "") return 0;
+        int64 n;
+        if (int64.try_parse(address, out n)) return (int)n;
+        return -(int)(address.hash() % 1000000) - 1000;
+    }
+
+    internal static int workspace_id_of(Json.Object obj) {
+        if (obj.has_member("id")) return (int)obj.get_int_member("id");
+        if (obj.has_member("address")) return workspace_id(obj.get_string_member("address"));
+        return 0;
+    }
